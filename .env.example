# Example Environment Configuration File
# Copy this file to .env and update with your actual credentials

# Base URL for the application
BASE_URL=https://opensource-demo.orangehrmlive.com/

# Test Environment Settings
TEST_TIMEOUT=30000
HEADLESS=true

# Browser Configuration
DEFAULT_BROWSER=chromium
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=720

# Test Data
DEFAULT_WAIT_TIME=5000
PAGE_LOAD_TIMEOUT=15000

# Test User Credentials - Admin Role
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_admin_password
ADMIN_DISPLAY_NAME=Administrator
ADMIN_EMPLOYEE_ID=EMP001

# Test User Credentials - ESS (Employee Self Service) Role
ESS_USERNAME=your_ess_username
ESS_PASSWORD=your_ess_password
ESS_DISPLAY_NAME=ESS User
ESS_EMPLOYEE_ID=EMP002

# Test User Credentials - Manager Role
MANAGER_USERNAME=your_manager_username
MANAGER_PASSWORD=your_manager_password
MANAGER_DISPLAY_NAME=Manager User
MANAGER_EMPLOYEE_ID=EMP003

# Test Environment Configuration
TEST_ENVIRONMENT=demo
API_BASE_URL=https://opensource-demo.orangehrmlive.com/web/index.php/api/v2

# Allure Reporting Configuration
ALLURE_RESULTS_DIR=allure-results
ALLURE_REPORT_DIR=allure-report
ALLURE_DETAIL_REPORTING=true
ALLURE_ENVIRONMENT_INFO=true